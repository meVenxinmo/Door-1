				Toggle.Track.BackgroundColor3 = Scheme.AccentColor
			end
		end)

		Click.MouseButton1Click:Connect(function()
			if Toggle.Disabled then
				return
			end
			Toggle:SetValue(not Toggle.Value)
		end)

