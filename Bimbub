	local function ApplyFilter()
		local Tab = State.Tab
		if not Tab then
			return
		end
		local Query = Search.Text:lower()
		for _, Section in ipairs(Tab.Sections) do
			local Any = false
			for _, Item in ipairs(Section.Items) do
				local Match
				if Query == "" then
					Match = true
				else
					Match = Item.Text ~= nil and Item.Text:find(Query, 1, true) ~= nil
				end
				Item.Frame.Visible = Match
				if Match then
					Any = true
				end
			end
			Section.Frame.Visible = Any or #Section.Items == 0
		end
	end

	Search:GetPropertyChangedSignal("Text"):Connect(ApplyFilter)

