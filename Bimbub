			AttachTip(Click, Options.DisabledTooltip)
		else
			AttachTip(Click, Options.Tooltip)
		end

		Library.Toggles[Name] = Toggle
		AddItem(Row, Toggle.Text)

		local Queue = Pending[Name]
		if Queue then
			Pending[Name] = nil
			for _, Entry in ipairs(Queue) do
				if Entry.Kind == "Key" then
					Entry.Bind.Toggle = Toggle
					Entry.Bind.Sync = Entry.Bind.WantSync
					Toggle.Linked = Entry.Bind
					AttachKey(Entry.Bind, Toggle)
				else
					AttachColor(Entry.Option, Toggle)
				end
			end
		end

		return Toggle
	end

