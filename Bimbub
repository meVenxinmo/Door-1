	function DropdownMeta:Display()
		local Parts = {}
		if self.Multi then
			for _, Value in ipairs(self.Values) do
				if self.Value[Value] then
					table.insert(Parts, T(Value))
				end
			end
		elseif self.Value ~= nil then
			table.insert(Parts, T(self.Value))
		end
		self.Current.Text = #Parts > 0 and table.concat(Parts, ", ") or "Không có"

		for Value, Button in pairs(self.Buttons) do
			local Selected
			if self.Multi then
				Selected = self.Value[Value] == true
			else
				Selected = self.Value == Value
			end
			Button.TextColor3 = Selected and Scheme.AccentColor or Colors.Text
			Button.Check.Visible = Selected
		end
	end

	function DropdownMeta:Build()
		for _, Button in pairs(self.Buttons) do
			Button:Destroy()
		end
		self.Buttons = {}

		for Index, Value in ipairs(self.Values) do
			local Button = New("TextButton", {
				Size = UDim2.new(1, 0, 0, 24),
				BackgroundColor3 = Colors.Panel,
				AutoButtonColor = false,
				Text = T(tostring(Value)),
				Font = FontMain,
				TextSize = 12,
				TextColor3 = Colors.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = Index,
			}, self.List)
			Round(Button, 3)
			Pad(Button, 10, 10, 0, 0)
			Hover(Button, Colors.Panel, Colors.ItemHover)

			Button.Check = New("TextLabel", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(16, 16),
				BackgroundTransparency = 1,
				Text = "✓",
				Font = FontBold,
				TextSize = 12,
				TextColor3 = Scheme.AccentColor,
				Visible = false,
			}, Button)

			Button.MouseButton1Click:Connect(function()
				if self.Multi then
					local Count = 0
					for _ in pairs(self.Value) do
						Count = Count + 1
					end
					if self.Value[Value] then
						if Count > 1 or self.AllowNull then
							self.Value[Value] = nil
						end
					else
						self.Value[Value] = true
					end
				else
					if self.Value == Value and self.AllowNull then
						self.Value = nil
					else
						self.Value = Value
					end
					self:Toggle(false)
				end
				self:Display()
				Fire(self)
			end)

			self.Buttons[Value] = Button
		end
	end

	function DropdownMeta:Toggle(Open)
		self.Open = Open
		self.List.Visible = Open
		self.Arrow.Text = Open and "▴" or "▾"
	end

	function DropdownMeta:SetValue(Value)
		if self.Multi then
			local Result = {}
			if type(Value) == "table" then
				for Key, Flag in pairs(Value) do
					if type(Key) == "number" then
						Result[Flag] = true
					elseif Flag then
						Result[Key] = true
					end
				end
			end
			self.Value = Result
		else
			if type(Value) == "number" then
				Value = self.Values[Value]
			end
			self.Value = Value
		end
		self:Display()
		Fire(self)
	end

	function DropdownMeta:SetValues(Values)
		self.Values = Values
		local Valid = {}
		for _, Value in ipairs(Values) do
			Valid[Value] = true
		end
		if self.Multi then
			for Key in pairs(self.Value) do
				if not Valid[Key] then
					self.Value[Key] = nil
				end
			end
		elseif self.Value ~= nil and not Valid[self.Value] then
			self.Value = nil
		end
		self:Build()
		self:Display()
	end

