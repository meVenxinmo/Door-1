do
	local RunService = game:GetService("RunService")
	local Env = BimHub.Environment

	local Settings = {
		FillTransparency = 0.75,
		OutlineTransparency = 0,
		TextTransparency = 0,
		TextOutlineTransparency = 0,
		TextSize = 18,
		Font = Enum.Font.GothamBold,
		ShowDistance = true,
		RenderLimit = 100000,
		Rainbow = false,
		FadeTime = 0.25,
		Tracers = false,
		TracerOrigin = "Bottom",
		TracerSize = 1,
		Arrows = false,
		ArrowRadius = 250,
		DistanceSizeRatio = 1,
	}

	local ESP = {
		Entries = {},
		ColorTable = setmetatable({}, { __mode = "k" }),
	}

	function ESP:GenerateRandomString()
		local Characters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
		local Result = {}
		for Index = 1, 14 do
			local Pick = math.random(1, #Characters)
			Result[Index] = Characters:sub(Pick, Pick)
		end
		return table.concat(Result)
	end

	local Folder = Instance.new("Folder")
	Folder.Name = ESP:GenerateRandomString()
	Folder.Parent = (Env.gethui and Env.gethui()) or game:GetService("CoreGui")

	local function GetPart(Object)
		if Object:IsA("BasePart") then
			return Object
		end
		if Object:IsA("Model") then
			return Object.PrimaryPart or Object:FindFirstChildWhichIsA("BasePart", true)
		end
		return Object:FindFirstChildWhichIsA("BasePart", true)
	end

	local function Apply(Entry, Color)
		Entry.Highlight.FillColor = Color
		Entry.Highlight.OutlineColor = Color
		Entry.Label.TextColor3 = Color
	end

	function ESP:AddESP(Options)
		local Object = Options.Object
		if not Object or not Object.Parent then
			return
		end

		local Color = Options.Color or self.ColorTable[Object] or Color3.new(1, 1, 1)
		self.ColorTable[Object] = Color

		local Existing = self.Entries[Object]
		if Existing then
			Existing.Text = Options.Text or Existing.Text
			Apply(Existing, Color)
			return
		end

		local Highlight = Instance.new("Highlight")
		Highlight.Adornee = Object
		Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		Highlight.FillTransparency = Settings.FillTransparency
		Highlight.OutlineTransparency = Settings.OutlineTransparency
		Highlight.Parent = Folder

		local Part = GetPart(Object)

		local Billboard = Instance.new("BillboardGui")
		Billboard.AlwaysOnTop = true
		Billboard.Size = UDim2.fromOffset(240, 40)
		Billboard.StudsOffset = Vector3.new(0, 2, 0)
		Billboard.LightInfluence = 0
		Billboard.Adornee = Part
		Billboard.Parent = Folder

		local Label = Instance.new("TextLabel")
		Label.BackgroundTransparency = 1
		Label.Size = UDim2.fromScale(1, 1)
		Label.Font = Settings.Font
		Label.TextSize = Settings.TextSize
		Label.TextTransparency = Settings.TextTransparency
		Label.TextStrokeTransparency = Settings.TextOutlineTransparency
		Label.Text = Options.Text or Object.Name
		Label.Parent = Billboard

		local Entry = {
			Object = Object,
			Part = Part,
			Highlight = Highlight,
			Billboard = Billboard,
			Label = Label,
			Text = Options.Text or Object.Name,
		}

		Apply(Entry, Color)
		self.Entries[Object] = Entry

		Object.Destroying:Connect(function()
			ESP:RemoveESP(Object)
		end)
	end

	function ESP:RemoveESP(Object)
		local Entry = self.Entries[Object]
		if not Entry then
			return
		end
		self.Entries[Object] = nil
		Entry.Highlight:Destroy()
		Entry.Billboard:Destroy()
	end

	function ESP:UpdateObjectColor(Object, Color)
		if not Object then
			return
		end
		self.ColorTable[Object] = Color
		local Entry = self.Entries[Object]
		if Entry then
			Apply(Entry, Color)
		end
	end

	local function EachEntry(Callback)
		for _, Entry in pairs(ESP.Entries) do
			Callback(Entry)
		end
	end

	function ESP:SetFillTransparency(Value)
		Settings.FillTransparency = Value
		EachEntry(function(Entry)
			Entry.Highlight.FillTransparency = Value
		end)
	end

	function ESP:SetOutlineTransparency(Value)
		Settings.OutlineTransparency = Value
		EachEntry(function(Entry)
			Entry.Highlight.OutlineTransparency = Value
		end)
	end

	function ESP:SetTextTransparency(Value)
		Settings.TextTransparency = Value
		EachEntry(function(Entry)
			Entry.Label.TextTransparency = Value
		end)
	end

	function ESP:SetTextOutlineTransparency(Value)
		Settings.TextOutlineTransparency = Value
		EachEntry(function(Entry)
			Entry.Label.TextStrokeTransparency = Value
		end)
	end

	function ESP:SetTextSize(Value)
		Settings.TextSize = Value
		EachEntry(function(Entry)
			Entry.Label.TextSize = Value
		end)
	end

	function ESP:SetFont(Value)
		if typeof(Value) == "string" then
			local Success, Result = pcall(function()
				return Enum.Font[Value]
			end)
			if not Success then
				return
			end
			Value = Result
		end
		Settings.Font = Value
		EachEntry(function(Entry)
			Entry.Label.Font = Value
		end)
	end

	function ESP:SetShowDistance(Value)
		Settings.ShowDistance = Value
	end

	function ESP:SetRenderLimit(Value)
		Settings.RenderLimit = Value
	end

	function ESP:SetRainbow(Value)
		Settings.Rainbow = Value
		if not Value then
			EachEntry(function(Entry)
				Apply(Entry, ESP.ColorTable[Entry.Object] or Color3.new(1, 1, 1))
			end)
		end
	end

	function ESP:SetFadeTime(Value)
		Settings.FadeTime = Value
	end

	function ESP:SetTracers(Value)
		Settings.Tracers = Value
	end

	function ESP:SetTracerOrigin(Value)
		Settings.TracerOrigin = Value
	end

	function ESP:SetTracerSize(Value)
		Settings.TracerSize = Value
	end

	function ESP:SetArrows(Value)
		Settings.Arrows = Value
	end

	function ESP:SetArrowRadius(Value)
		Settings.ArrowRadius = Value
	end

	function ESP:SetDistanceSizeRatio(Value)
		Settings.DistanceSizeRatio = Value
	end

	local Hue = 0
	local Connection = RunService.Heartbeat:Connect(function(Delta)
		local Camera = workspace.CurrentCamera
		if not Camera then
			return
		end
		Hue = (Hue + Delta * 0.2) % 1
		local Rainbow = Color3.fromHSV(Hue, 1, 1)
		local Origin = Camera.CFrame.Position

		for Object, Entry in pairs(ESP.Entries) do
			if not Object.Parent then
				ESP:RemoveESP(Object)
			else
				local Part = Entry.Part
				if not Part or not Part.Parent then
					Part = GetPart(Object)
					Entry.Part = Part
					Entry.Billboard.Adornee = Part
				end
				if Part then
					local Distance = (Origin - Part.Position).Magnitude
					local Visible = Distance <= Settings.RenderLimit
					Entry.Highlight.Enabled = Visible
					Entry.Billboard.Enabled = Visible
					if Visible then
						if Settings.ShowDistance then
							Entry.Label.Text = Entry.Text .. " [" .. math.floor(Distance) .. "]"
						else
							Entry.Label.Text = Entry.Text
						end
						if Settings.Rainbow then
							Apply(Entry, Rainbow)
						end
					end
				end
			end
		end
	end)

	function ESP:Unload()
		Connection:Disconnect()
		for Object in pairs(self.Entries) do
			self:RemoveESP(Object)
		end
		Folder:Destroy()
	end

	BimHub.ESPLibrary = ESP
end

