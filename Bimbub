	local function Format(Slider, Value)
		local Text = string.format("%." .. Slider.Rounding .. "f", Value)
		return (Slider.Prefix or "") .. Text .. (Slider.Suffix or "")
	end

	function SliderMeta:Display()
		local Alpha = 0
		if self.Max > self.Min then
			Alpha = (self.Value - self.Min) / (self.Max - self.Min)
		end
		self.Fill.Size = UDim2.fromScale(math.clamp(Alpha, 0, 1), 1)
		self.ValueLabel.Text = Format(self, self.Value)
	end

	function SliderMeta:Normalize(Value)
		Value = math.clamp(Value, self.Min, self.Max)
		local Step = 10 ^ -self.Rounding
		Value = math.floor(Value / Step + 0.5) * Step
		return tonumber(string.format("%." .. self.Rounding .. "f", Value))
	end

	function SliderMeta:SetValue(Value)
		Value = self:Normalize(tonumber(Value) or self.Min)
		if Value == self.Value then
			return
		end
		self.Value = Value
		self:Display()
		Fire(self)
	end

	function SliderMeta:SetMax(Value)
		self.Max = Value
		self.Value = self:Normalize(self.Value)
		self:Display()
	end

	function SliderMeta:SetMin(Value)
		self.Min = Value
		self.Value = self:Normalize(self.Value)
		self:Display()
	end

