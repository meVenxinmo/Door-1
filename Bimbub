	function BimHub.RegisterKeybind(ToggleName, Name, Options)
		Options = Options or {}
		if Library.Options[Name] then
			return Library.Options[Name]
		end
		local Toggle = Library.Toggles[ToggleName]
		local Bind = NewBind(Name, Options, Toggle)
		if Toggle then
			AttachKey(Bind, Toggle)
		else
			Pending[ToggleName] = Pending[ToggleName] or {}
			table.insert(Pending[ToggleName], { Kind = "Key", Bind = Bind })
		end
		return Bind
	end

