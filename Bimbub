	Connect(UserInputService.InputBegan, function(Input)
		if State.Listening then
			if Input.UserInputType == Enum.UserInputType.Keyboard then
				local Bind = State.Listening
				State.Listening = nil
				if Input.KeyCode == Enum.KeyCode.Escape then
					Bind:SetValue("None")
				else
					Bind:SetValue(Input.KeyCode.Name)
				end
			end
			return
		end

		if UserInputService:GetFocusedTextBox() then
			return
		end

		if Input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end

		for _, Bind in ipairs(Binds) do
			if Bind.Value ~= "None" and Input.KeyCode.Name == Bind.Value then
				if Bind.Mode == "Toggle" then
					Bind.State = not Bind.State
				else
					Bind.State = true
				end
				if Bind.Toggle and Bind.Sync then
					Bind.Toggle:SetValue(Bind.State)
				end
				for _, Callback in ipairs(Bind.Clicks) do
					task.spawn(Callback, Bind.State)
				end
			end
		end
	end)

	Connect(UserInputService.InputEnded, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			State.Drag = nil
		end
		if Input.UserInputType == Enum.UserInputType.Keyboard then
			for _, Bind in ipairs(Binds) do
				if Bind.Mode == "Hold" and Bind.Value ~= "None" and Input.KeyCode.Name == Bind.Value then
					Bind.State = false
					if Bind.Toggle and Bind.Sync then
						Bind.Toggle:SetValue(false)
					end
				end
			end
		end
	end)

	Connect(UserInputService.InputChanged, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
			if State.Drag then
				State.Drag(Vector2.new(Input.Position.X, Input.Position.Y))
			end
		end
	end)

	local Dragging = nil
	TitleBar.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = {
				Start = Vector2.new(Input.Position.X, Input.Position.Y),
				Origin = Main.Position,
			}
		end
	end)

	Connect(UserInputService.InputChanged, function(Input)
		if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
			local Delta = Vector2.new(Input.Position.X, Input.Position.Y) - Dragging.Start
			local Origin = Dragging.Origin
			Main.Position = UDim2.new(
				Origin.X.Scale,
				Origin.X.Offset + Delta.X,
				Origin.Y.Scale,
				Origin.Y.Offset + Delta.Y
			)
			ShownPosition = Main.Position
		end
	end)

	Connect(UserInputService.InputEnded, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = nil
		end
	end)

